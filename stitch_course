build_toc <- function(sessions) {
  # Only include items that are real sessions (have a title); skip image entries
  si <- 0L
  toc_entries <- character(0)
  for (item in sessions) {
    if (is.null(item$title)) next
    si <- si + 1L
    toc_entries <- c(toc_entries,
      paste0('<li><a href="#session-', si, '" ',
             'style="color:#2c5f8a;text-decoration:none;">',
             he(item$title), '</a></li>'))
  }
  items <- paste(toc_entries, collapse = "\n")
  paste0(
    '<div id="course-toc" style="position:fixed;top:20px;right:20px;',
    'width:270px;max-height:80vh;overflow-y:auto;background:#fafafa;',
    'border:1px solid #ccc;border-radius:6px;padding:14px;',
    'font-family:sans-serif;font-size:.82em;z-index:9999;',
    'box-shadow:0 4px 16px rgba(0,0,0,.18);">',
    '<div style="font-weight:700;margin-bottom:8px;">Course Contents</div>',
    '<ul style="list-style:none;margin:0;padding:0;line-height:1.8;">',
    items, '</ul>',
    '<div style="margin-top:10px;text-align:right;">',
    '<button onclick="document.getElementById(\'course-toc\').style.display=\'none\';',
    'document.getElementById(\'show-toc\').style.display=\'block\';" ',
    'style="cursor:pointer;padding:2px 8px;font-size:13px;">Hide \u2715</button>',
    '</div></div>',
    '<button id="show-toc" style="display:none;position:fixed;',
    'top:20px;right:20px;z-index:9999;padding:4px 7px;font-size:16px;',
    'cursor:pointer;background:none;color:#333;border:none;" ',
    'onclick="document.getElementById(\'course-toc\').style.display=\'block\';',
    'this.style.display=\'none\';">\u2630</button>')
}

# ── Image slide ───────────────────────────────────────────────────────────────
# Local files (jpg/png/svg/gif) are base64-embedded so the HTML is fully
# self-contained and works when opened directly or hosted remotely.
# http/https URLs are used as-is.

image_mime <- function(path) {
  ext <- tolower(tools::file_ext(path))
  switch(ext,
    png  = "image/png",
    jpg  = , jpeg = "image/jpeg",
    svg  = "image/svg+xml",
    gif  = "image/gif",
    webp = "image/webp",
    "image/png")
}

image_slide <- function(src, caption = NULL) {
  cap_html <- if (!is.null(caption) && nchar(trimws(caption)) > 0)
    paste0('<div style="text-align:center;font-style:italic;font-size:.9em;',
           'margin-top:8px;color:#555;">', he(caption), '</div>')
  else ""

  img_src <- src
  if (!grepl("^https?://", src)) {
    if (file.exists(src)) {
      raw     <- readBin(src, "raw", file.info(src)$size)
      # base64encode may insert newlines every 76 chars -- strip them
      b64     <- gsub("[
]", "", base64encode(raw))
      img_src <- paste0("data:", image_mime(src), ";base64,", b64)
      message("  [image] embedded: ", src,
              "  (", round(nchar(b64) / 1024), " KB base64)")
    } else {
      warning("Image not found: ", src,
              "\n  (path is relative to working dir: ", getwd(), ")")
    }
  }

  paste0(
    '<div class="stitch-image-slide" ',
    'style="margin:100vh 0;padding:0;text-align:center;">',
    '<img src="', img_src, '" ',
    'style="width:100%;max-width:100%;height:auto;display:block;margin:0 auto;',
    'box-shadow:0 2px 12px rgba(0,0,0,.15);" ',
    'alt="', if (!is.null(caption)) he(caption) else "slide", '">',
    cap_html, '</div>')
}

# ── Webpage insert ───────────────────────────────────────────────────────────
# Reads a local HTML file or fetches a URL, extracts body content, and
# stitches it in with 25vh top/bottom spacing (1/4 of image slide spacing).
# If libs is provided (path or URL), it is used as the base for rewriting
# relative asset URLs.  If omitted, relative URLs are left as-is.
# label appears in the right-margin tab; defaults to filename or hostname.

webpage_insert <- function(src, libs = NULL, label = NULL, wp_index = 0) {
  # Derive label from src if not given
  if (is.null(label) || nchar(trimws(label)) == 0) {
    label <- if (grepl("^https?://", src))
      gsub("^www\\.", "", regmatches(src,
        regexpr("(?<=://)[^/]+", src, perl = TRUE)))
    else
      tools::file_path_sans_ext(basename(src))
  }

  # Read content
  message("  [webpage] ", src)
  html_text <- tryCatch({
    if (grepl("^https?://", src)) fetch_url(src)
    else if (file.exists(src)) paste(readLines(src, warn = FALSE), collapse = "
")
    else stop("not found")
  }, error = function(e) {
    warning("webpage_insert: cannot read '", src, "': ", e$message)
    return(NULL)
  })
  if (is.null(html_text))
    return(sprintf('<p><em>Could not load: %s</em></p>', he(src)))

  doc <- read_html(html_text)

  # Absolutize relative asset URLs using libs as base, or src directory
  base <- if (!is.null(libs) && nchar(trimws(libs)) > 0) {
    paste0(str_remove(libs, "/?$"), "/")
  } else if (grepl("^https?://", src)) {
    paste0(str_remove(src, "/[^/]*$"), "/")
  } else {
    paste0(dirname(normalizePath(src)), "/")
  }
  # Only absolutize if libs was explicitly provided; otherwise leave as-is
  if (!is.null(libs) && nchar(trimws(libs)) > 0) {
    for (attr in c("src", "href", "data-src")) {
      for (n in xml_find_all(doc, sprintf("//*[@%s]", attr))) {
        v <- xml_attr(n, attr)
        if (is.na(v) || v == "")         next
        if (str_starts(v, "http"))       next
        if (str_starts(v, "//"))         next
        if (str_starts(v, "data:"))      next
        if (str_starts(v, "#"))          next
        if (str_starts(v, "javascript")) next
        if (str_starts(v, "mailto:"))    next
        xml_attr(n, attr) <- paste0(base, v)
      }
    }
  }

  # Strip standard page chrome
  for (eid in c("quarto-sidebar", "quarto-toc-sidebar", "quarto-search",
                "quarto-header", "quarto-appendix", "quarto-search-results",
                "quarto-sidebar-glass", "quarto-margin-sidebar")) {
    nd <- xml_find_first(doc, sprintf("//*[@id='%s']", eid))
    if (!inherits(nd, "xml_missing"))
      tryCatch(xml_remove(nd), error = function(e) NULL)
  }
  for (tag in c("//footer", "//nav"))
    for (n in xml_find_all(doc, tag))
      tryCatch(xml_remove(n), error = function(e) NULL)

  # Extract content: prefer quarto-document-content, then main, then body
  main <- NULL
  for (xp in c("//*[@id='quarto-document-content']", "//main", "//body")) {
    nd <- tryCatch(xml_find_first(doc, xp), error = function(e) NULL)
    if (!is.null(nd) && !inherits(nd, "xml_missing")) { main <- nd; break }
  }
  if (is.null(main))
    return(sprintf('<p><em>No content extracted from: %s</em></p>', he(src)))

  body_html <- tryCatch(as.character(main), error = function(e) NULL)
  if (is.null(body_html) || is.na(body_html))
    return(sprintf('<p><em>Serialization failed: %s</em></p>', he(src)))

  # Synthetic key for the margin tab (unique per webpage entry)
  wp_key <- paste0("wp-", wp_index)

  # Margin tab (same style as book tabs)
  tab <- paste0(
    '<div class="stitch-book-tab" data-book="', wp_key, '" ',
    'style="display:none;position:fixed;top:50%;right:0;',
    'transform:translateY(-50%);',
    'background:#e8e8e8;color:#333;',
    'padding:4px 6px;font-family:sans-serif;font-size:.6em;',
    'font-weight:700;letter-spacing:.04em;',
    'border-radius:4px 0 0 4px;',
    'box-shadow:-1px 0 5px rgba(0,0,0,.15);z-index:500;',
    'writing-mode:vertical-rl;text-orientation:mixed;">',
    he(label), '</div>')

  # Sentinel banner (invisible, zero-height) that the tab JS uses to
  # detect when this webpage is in view — same mechanism as book banners
  sentinel <- paste0(
    '<div class="stitch-book-banner" data-book="', wp_key, '" ',
    'style="height:0;margin:0;padding:0;border:none;background:none;">',
    '</div>')

  # 25vh spacing (1/4 of the 100vh used for image slides)
  paste0(
    '<div class="stitch-webpage-insert" style="margin:25vh 0;">',
    sentinel, "
", tab, "
", body_html,
    '</div>')
}

# ── iframe insert ────────────────────────────────────────────────────────────
# Embeds a URL or local file in a full-viewport iframe, preserving all JS/CSS.
# Ideal for self-contained presentations (Marp, reveal.js, etc.) where
# extracting body HTML would break JavaScript-driven behaviour.
# spacing: 25vh above and below (same as webpage inserts).
# label: appears in the right-margin tab while the iframe is in view.

iframe_insert <- function(src, label = NULL, height = "90vh", wp_index = 0) {
  if (is.null(label) || nchar(trimws(label)) == 0) {
    label <- if (grepl("^https?://", src))
      gsub("^www\\.", "", regmatches(src,
        regexpr("(?<=://)[^/]+", src, perl = TRUE)))
    else
      tools::file_path_sans_ext(basename(src))
  }

  wp_key  <- paste0("wp-", wp_index)

  # Sentinel banner for margin tab JS tracking
  sentinel <- paste0(
    '<div class="stitch-book-banner" data-book="', wp_key, '" ',
    'style="height:0;margin:0;padding:0;border:none;background:none;"></div>')

  # Margin tab
  tab <- paste0(
    '<div class="stitch-book-tab" data-book="', wp_key, '" ',
    'style="display:none;position:fixed;top:50%;right:0;',
    'transform:translateY(-50%);',
    'background:#e8e8e8;color:#333;',
    'padding:4px 6px;font-family:sans-serif;font-size:.6em;',
    'font-weight:700;letter-spacing:.04em;',
    'border-radius:4px 0 0 4px;',
    'box-shadow:-1px 0 5px rgba(0,0,0,.15);z-index:500;',
    'writing-mode:vertical-rl;text-orientation:mixed;">',
    he(label), '</div>')

  # The iframe itself — width 100%, height configurable
  frame <- paste0(
    '<iframe src="', src, '" ',
    'style="width:100%;height:', height, ';border:none;display:block;" ',
    'allowfullscreen loading="lazy"></iframe>')

  paste0(
    '<div class="stitch-iframe-insert" style="margin:25vh 0;">',
    sentinel, "
", tab, "
", frame,
    '</div>')
}

# ── Page wrapper ──────────────────────────────────────────────────────────────

wrap_page <- function(title, presenters = NULL, cover_images = NULL,
                      head_deps, toc_html, body_html,
                      extra_body_scripts = character(0)) {
  our_css <- '
<style>
/* Course stitcher layout overrides — applied after Quarto CSS */
body { max-width:900px; margin:0 auto; padding:20px 40px 80px; }
/* Suppress residual Quarto chrome */
#quarto-sidebar, #quarto-toc-sidebar, #quarto-margin-sidebar,
#quarto-sidebar-glass, #quarto-header, .quarto-title-meta,
.navbar, nav.quarto-page-breadcrumbs { display:none !important; }
img { max-width:100%; height:auto; }
.stitch-image-slide img { width:100%; max-width:100%; height:auto; }
/* Prevent pre/code blocks from wrapping at any zoom level.
   overflow-x:auto adds a horizontal scrollbar only when needed,
   so at normal zoom nothing changes visually. */
pre, pre code {
  white-space: pre !important;
  overflow-x: auto !important;
  word-wrap: normal !important;
  word-break: normal !important;
  overflow-wrap: normal !important;
}
/* Inline code should not break mid-token */
code {
  word-break: keep-all !important;
  overflow-wrap: normal !important;
}
/* Tables: scroll horizontally rather than wrapping columns */
table {
  display: block;
  overflow-x: auto;
  max-width: 100%;
  white-space: nowrap;
}
/* But restore normal wrapping inside table cells so cell text still wraps */
th, td {
  white-space: normal;
}
</style>'

  tab_js <- '
<script>
(function() {
  function updateTab() {
    var banners = document.querySelectorAll(".stitch-book-banner");
    var tabs    = document.querySelectorAll(".stitch-book-tab");
    var current = null;
    var mid = window.scrollY + window.innerHeight / 2;
    banners.forEach(function(b) {
      if (b.getBoundingClientRect().top + window.scrollY <= mid)
        current = b.getAttribute("data-book");
    });
    tabs.forEach(function(t) {
      t.style.display =
        (t.getAttribute("data-book") === current) ? "block" : "none";
    });
  }
  window.addEventListener("scroll", updateTab, { passive: true });
  window.addEventListener("load",   updateTab);
  updateTab();
})();
</script>'

  # Build cover images block outside paste0 to avoid length > 1 issues
  cover_html <- if (!is.null(cover_images) && length(cover_images) > 0)
    paste(vapply(as.list(cover_images), function(img)
      image_slide(path.expand(as.character(img))), character(1)),
      collapse="\n")
  else ""

  paste0(
    '<!DOCTYPE html>\n<html lang="en">\n<head>\n',
    '<meta charset="UTF-8">\n',
    '<meta name="viewport" content="width=device-width,initial-scale=1.0">\n',
    '<title>', he(title), '</title>\n',
    head_deps, '\n',
    our_css, '\n',
    '</head>\n<body>\n',
    cover_html,
    '<div style="text-align:center;padding:40px 0 20px;font-family:sans-serif;">',
    '<h1 style="font-size:2.2em;color:#1a4e8a;">', he(title), '</h1>',
    if (!is.null(presenters) && nchar(trimws(presenters)) > 0) {
      lines <- strsplit(trimws(presenters), "\n")[[1]]
      # Empty/blank lines become <br> spacers; non-empty lines are escaped
      rendered <- vapply(lines, function(l)
        if (nchar(trimws(l)) == 0) "" else he(trimws(l)), character(1))
      paste0('<div style="margin-top:1.5em;font-size:1.6em;line-height:2;">',
             paste(rendered, collapse="<br>"),
             '</div>')
    } else "",
    '</div>\n',
    toc_html, '\n',
    body_html, '\n',
    paste(extra_body_scripts, collapse = "\n"), '\n',
    tab_js, '\n',
    '</body>\n</html>')
}

# ── Main ──────────────────────────────────────────────────────────────────────

args     <- commandArgs(trailingOnly = TRUE)
nav_file <- if (length(args) >= 1) args[1] else "course_nav.yaml"
out_file <- if (length(args) >= 2) args[2] else NULL
nav      <- yaml.load_file(nav_file)
if (!is.null(nav$output_file) && is.null(out_file)) out_file <- nav$output_file
if (is.null(out_file)) out_file <- "course_session.html"

message("=== Course Stitcher ===")
message("Nav : ", nav_file)
message("Out : ", out_file)

toc_cache    <- list()
head_deps    <- NULL
body_scripts <- character(0)

get_toc <- function(key) {
  if (is.null(toc_cache[[key]])) {
    message("[TOC] ", key)
    t <- parse_toc(key)
    message("      ", nrow(t), " chapters")
    toc_cache[[key]] <<- t
  }
  toc_cache[[key]]
}

body_parts <- character(0)
last_book  <- NULL
wp_counter <- 0L

si <- 0L  # session counter (only incremented for real sessions)
for (item in nav$sessions) {

  # Top-level image between sessions (sibling of session objects)
  if (!is.null(item$image) && is.null(item$title)) {
    message("\n[image between sessions] ", item$image)
    body_parts <- c(body_parts,
      image_slide(path.expand(item$image), item$caption))
    next
  }

  # Top-level webpage between sessions
  if (!is.null(item$webpage) && is.null(item$title)) {
    wp_counter <<- wp_counter + 1L
    message("\n[webpage between sessions] ", item$webpage)
    body_parts <- c(body_parts,
      webpage_insert(item$webpage, item$libs, item$label, wp_counter))
    next
  }

  # Top-level iframe between sessions
  if (!is.null(item$iframe) && is.null(item$title)) {
    wp_counter <<- wp_counter + 1L
    message("\n[iframe between sessions] ", item$iframe)
    height <- if (!is.null(item$height)) as.character(item$height) else "90vh"
    body_parts <- c(body_parts,
      iframe_insert(item$iframe, item$label, height, wp_counter))
    next
  }

  sess <- item
  si   <- si + 1L
  message("\n--- Session ", si, ": ", sess$title)
  body_parts <- c(body_parts, session_banner(sess$title, si))

  for (entry in sess$sections) {

    # Image slide entry
    if (!is.null(entry$image)) {
      message("  [image] ", path.expand(entry$image))
      body_parts <- c(body_parts,
        image_slide(path.expand(entry$image), entry$caption))
      next
    }

    # Webpage insert entry
    if (!is.null(entry$webpage)) {
      wp_counter <<- wp_counter + 1L
      body_parts <- c(body_parts,
        webpage_insert(entry$webpage, entry$libs, entry$label, wp_counter))
      next
    }

    # iframe insert entry
    if (!is.null(entry$iframe)) {
      wp_counter <<- wp_counter + 1L
      height <- if (!is.null(entry$height)) as.character(entry$height) else "90vh"
      body_parts <- c(body_parts,
        iframe_insert(entry$iframe, entry$label, height, wp_counter))
      next
    }

    bk <- entry$book
    if (is.null(bk) || !bk %in% names(BOOKS)) {
      warning("Unknown or missing book key: ", bk %||% "(null)"); next
    }

    if (is.null(last_book) || last_book != bk) {
      body_parts <- c(body_parts, book_banner(bk))
      last_book  <- bk
    }

    specs    <- as.character(unlist(entry$include))
    toc      <- get_toc(bk)
    excludes <- if (!is.null(entry$exclude)) as.character(unlist(entry$exclude)) else character(0)
    chapters <- resolve_chapters(specs, excludes, toc)

    if (length(chapters) == 0) {
      warning("No chapters resolved: book=", bk,
              " specs=", paste(specs, collapse = ",")); next
    }

    for (chap in chapters) {
      message("  [", bk, "] Ch ", chap$num, " — ", chap$title)
      message("    specs: ", paste(chap$specs, collapse = ", "))

      html_text <- tryCatch(fetch_page(chap$url, bk), error = function(e) {
        warning("Fetch failed: ", e$message); NULL
      })
      if (is.null(html_text)) next

      # Extract head deps once from the first successfully fetched chapter
      if (is.null(head_deps)) {
        message("  [head] extracting from ", chap$url)
        head_deps <- tryCatch(
          extract_head_deps(html_text, BOOKS[[bk]]$base),
          error = function(e) {
            warning("Head extraction failed: ", e$message); ""
          })
      }

      # Collect diagram init scripts
      body_scripts <- unique(c(body_scripts,
        tryCatch(extract_body_scripts(html_text), error = function(e) character(0))))

      content <- tryCatch(
        extract_content(html_text, chap$url, chap$specs, chap$excludes),
        error = function(e) {
          warning("extract_content failed: ", e$message)
          sprintf("<p><em>Error loading %s: %s</em></p>", chap$url, e$message)
        })

      if (is.null(content) || all(is.na(content)) || all(nchar(trimws(content)) == 0)) {
        warning("Empty content for ", chap$url)
        content <- sprintf("<p><em>Empty content from %s</em></p>", chap$url)
      }

      body_parts <- c(body_parts,
        sprintf('<div class="chapter-section" data-book="%s" data-ch="%s">',
                bk, chap$num),
        content,
        '</div>')
    }
  }
}

message("\nbody_parts : ", length(body_parts))
message("NA entries : ", sum(is.na(body_parts)))
if (length(body_scripts) > 0)
  message("diagram scripts: ", length(body_scripts))

toc_html  <- build_toc(nav$sessions)
body_html <- paste(body_parts, collapse = "\n")
message("body_html chars: ", nchar(body_html))

full_html <- wrap_page(
  nav$title %||% "Course Session",
  presenters  = nav$presenters,
  cover_images = if (!is.null(nav$images)) as.list(nav$images)
                 else if (!is.null(nav$image)) list(nav$image)
                 else NULL,
  head_deps   = head_deps %||% "",
  toc_html    = toc_html,
  body_html   = body_html,
  extra_body_scripts = body_scripts)

# writeLines() can mangle very long lines (e.g. base64-embedded images).
# Use a binary-mode connection with cat() instead, safe for any string length.
con <- file(out_file, open = "wb")
cat(full_html, file = con, sep = "")
close(con)
message("\n\u2713  ", out_file, "  (", round(file.size(out_file) / 1024), " KB)")
